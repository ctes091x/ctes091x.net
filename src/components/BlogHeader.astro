---
import { formatDate } from "../lib/posts";

interface Props {
  title: string;
  pubDate: Date;
  modDate?: Date;
  /** リポジトリルートからの Markdown ファイルのパス */
  sourcePath?: string;
}

const { title, pubDate, modDate, sourcePath } = Astro.props;
const pageUrl = new URL(Astro.url.pathname, Astro.site);

const tweetUrl = `https://x.com/intent/tweet?text=${encodeURIComponent(`${title} - 綿糸てせのブログ`)}&url=${encodeURIComponent(pageUrl.href)}`;
const sourceUrl = sourcePath && `https://github.com/ctes091x/ctes091x.net/blob/main/${sourcePath}`;

const linkClass = "underline decoration-zinc-400/60 underline-offset-4 transition-colors hover:text-zinc-900 hover:decoration-accent dark:hover:text-zinc-100";
---

<header class="mb-10 border-b border-zinc-200 pb-6 dark:border-zinc-800">
  <h1 class="text-2xl leading-snug font-bold tracking-tight md:text-3xl">{title}</h1>
  <div class="mt-4 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 text-sm text-zinc-500 dark:text-zinc-400">
    <p class="flex flex-wrap gap-x-4 tabular-nums">
      <span>投稿日 <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time></span>
      {modDate && <span>最終更新日 <time datetime={modDate.toISOString()}>{formatDate(modDate)}</time></span>}
    </p>
    <p class="flex gap-x-4">
      <a target="_blank" rel="noopener noreferrer" href={tweetUrl} class={linkClass}>ツイート</a>
      {sourceUrl && <a target="_blank" rel="noopener noreferrer" href={sourceUrl} class={linkClass}>GitHubで見る</a>}
    </p>
  </div>
</header>
