---
interface Props {
  name: string;
  url: string;
  iconId: string;
  desc: string;
}

const { name, url, iconId, desc } = Astro.props;
---

<li>
  <a
    href={url}
    target="_blank"
    class="flex h-full items-center gap-3 rounded-xl border border-zinc-200 p-3 transition-colors hover:border-accent hover:bg-zinc-50 dark:border-zinc-800 dark:hover:border-accent dark:hover:bg-zinc-800/50"
  >
    <img
      src={"https://unavatar.io/" + iconId}
      width="48"
      height="48"
      alt=""
      loading="lazy"
      decoding="async"
      class="size-12 shrink-0 rounded-full bg-zinc-100 object-cover dark:bg-zinc-800"
    />
    <div class="min-w-0">
      <p class="font-medium leading-snug">{name}</p>
      <p class="mt-0.5 text-xs leading-relaxed text-zinc-500 dark:text-zinc-400">{desc}</p>
    </div>
  </a>
</li>
