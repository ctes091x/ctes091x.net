---
import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import HeadSEO from "../components/HeadSEO.astro"

import "../styles/global.css"

const { type, title, ogImage } = Astro.props;
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8">
    <title>{title} - 綿糸てせ{(type=="blog" ? "のブログ" : "")}</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <HeadSEO type={type} title={title} ogImage={ogImage} />
  </head>
  <body class="flex min-h-dvh flex-col bg-white text-zinc-800 antialiased dark:bg-zinc-900 dark:text-zinc-200">
    <Header />
    <main class="page-container flex-1 py-10">
      <slot />
    </main>
    <Footer />
  </body>
</html>
