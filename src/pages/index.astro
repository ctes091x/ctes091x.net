---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import ReciprocalLinks from "../components/ReciprocalLinks.astro";
import { getPublishedPosts, formatDate } from "../lib/posts";

const recentPosts = (await getPublishedPosts()).slice(0, 5);

const clubs = [
  "SF研究会 (電気通信大学学友会準公認)",
  "MMA (電気通信大学公認)",
  "工学研究部 (電気通信大学公認)",
  "文芸・文学総合研究会 (電気通信大学公認)",
  "UEComic! 準備会 (電気通信大学学友会準公認)",
  "バーチャルライブ研究会 (電気通信大学公認)",
];

const links = [
  { label: "Blog", href: "/blog/", text: "https://ctes091x.net/blog/" },
  { label: "Twitter", href: "https://twitter.com/ctes091x", text: "@ctes091x" },
  { label: "Bluesky", href: "https://bsky.app/profile/bsky.ctes091x.net", text: "bsky.ctes091x.net" },
  { label: "GitHub", href: "https://github.com/ctes091x", text: "@ctes091x" },
  { label: "Qiita", href: "https://qiita.com/users/ctes091x", text: "@ctes091x" },
  { label: "Zenn", href: "https://zenn.dev/ctes091x", text: "@ctes091x" },
  { label: "Keybase", href: "https://keybase.io/ctes091x", text: "@ctes091x" },
];

const linkClass = "underline decoration-accent/50 underline-offset-4 transition-colors hover:decoration-accent";
---

<Base title="トップページ">
  <div class="space-y-14">
    <div class="flex items-center gap-5">
      <img src="https://github.com/ctes091x.png" width="80" height="80" alt="" class="size-20 rounded-full" />
      <div>
        <h1 class="text-3xl font-bold tracking-tight">綿糸てせ</h1>
        <p class="mt-1 text-ctp-subtext0">@ctes091x</p>
      </div>
    </div>

    <Section title="About" id="about">
      <h3 class="mb-2 text-sm font-semibold tracking-wide text-ctp-subtext0 uppercase">Affiliation</h3>
      <p class="font-medium">電気通信大学 情報理工学域 I類 (2025~)</p>
      <ul class="mt-2 list-disc space-y-1 pl-5 marker:text-accent">
        {clubs.map(club => <li>{club}</li>)}
      </ul>
    </Section>

    <Section title="Recent Posts">
      <ul class="divide-y divide-ctp-surface0">
        {recentPosts.map(post => (
          <li class="flex flex-col gap-x-4 py-2.5 sm:flex-row sm:items-baseline">
            <time datetime={post.data.pubDate.toISOString()} class="shrink-0 text-sm text-ctp-subtext0 tabular-nums">
              {formatDate(post.data.pubDate)}
            </time>
            <a href={`/blog/${post.id}/`} class={linkClass}>{post.data.title}</a>
          </li>
        ))}
      </ul>
      <p class="mt-4">
        <a href="/blog/" class="text-sm font-medium text-ctp-subtext0 transition-colors hover:text-ctp-text">すべての記事 →</a>
      </p>
    </Section>

    <Section title="Links" id="links">
      <dl class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-2">
        {links.map(({ label, href, text }) => (
          <dt class="text-ctp-subtext0">{label}</dt>
          <dd class="min-w-0 break-words"><a href={href} class={linkClass}>{text}</a></dd>
        ))}
      </dl>
    </Section>

    <Section title="Reciprocal Links">
      <ReciprocalLinks />
    </Section>
  </div>
</Base>
